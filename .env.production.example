# Copy to .env.production and fill in. Used by docker-compose (env_file).

# Public URL users type. Pins the Google / Microsoft OAuth redirects and makes session cookies Secure. REQUIRED.
PUBLIC_BASE_URL=https://ledger.prasanit.org
# Same host without scheme, for Caddy's TLS certificate.
LEDGER_DOMAIN=ledger.prasanit.org

# Encrypts the Claude API key, the Microsoft/Google app secrets and the sign-in tokens in the database.
# REQUIRED. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it safe: losing it means re-entering the key and reconnecting every source.
APP_SECRET_KEY=

# Built-in admin login, applied at every start. With these set, /admin never asks you to create a
# password and the password can only be changed here (edit + `docker compose up -d`).
# ADMIN_EMAIL is the sign-in name the login box requires; 10+ character password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Which model reads the documents: claude (Anthropic API, key saved in Admin → Claude API) or ollama
# (a self-hosted server reachable from this container; it must never be exposed to the internet).
LLM_PROVIDER=claude
# OLLAMA_BASE_URL=http://192.168.0.183:11434
# OLLAMA_MODEL=qwen2.5:3b
# LLM_FALLBACK=0

# Optional hardening: only allow local-folder sources under these paths inside the container.
# LOCAL_ROOTS=/data/inbox

# Optional initial defaults (editable in Admin afterwards)
COMPANY_NAME=Vista Roofing Limited
BASE_CURRENCY=EUR
COUNTRY=Ireland

# Never set APP_DEBUG=1 in production (it puts exception details in API responses).
APP_DEBUG=0
