# Everything below is OPTIONAL. All settings are managed in the Admin screen (http://127.0.0.1:8000/admin)
# and stored in data/ledger.db. Values here are only used as initial defaults before you change them in Admin.

PORT=8000
# DATA_DIR=C:\path\to\data

# Admin login. Leave empty to create the password in the browser on first visit; set it here to have
# the app take it from this file at every start (then it can only be changed here). With ADMIN_EMAIL
# set, the admin signs in with that email; without it, with the email field left empty.
# (These two are also read from .env.production when not set here, so one login works everywhere.)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# ---- Which model reads the documents (changeable later in Admin → Document reader) ----
# ollama = a self-hosted Ollama server on your network (default; text only, nothing leaves the LAN)
# claude = the Anthropic API, gemini = the Google Gemini API (both read photos and scanned PDFs; need a key)
LLM_PROVIDER=ollama
# LLM_FALLBACK=              # second reader (claude | gemini | ollama) when the first is unreachable, unfunded, or cannot read a file
OLLAMA_BASE_URL=http://192.168.0.183:11434
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_VISION_MODEL=qwen3-vl:2b   # optional: photos and scanned PDFs read locally too (ollama pull qwen3-vl:2b)
# OLLAMA_NUM_CTX=8192        # context tokens (minimum 8192; long documents are cut to fit)
# OLLAMA_TIMEOUT=180         # seconds per request (the first request loads the model)
# OLLAMA_KEEP_ALIVE=30m      # keep the model loaded between documents
# GEMINI_API_KEY=AIza...     # or paste it in Admin (stored encrypted); use a project with billing enabled
# GEMINI_MODEL=auto            # newest Flash model the key can use; or a name from Test key's list

# ---- Email alerts: reader down / back, sync stopped (editable later in Admin → Alerts) ----
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls             # starttls | ssl | none
# SMTP_USER=alerts@yourcompany.ie
# SMTP_PASSWORD=                     # an app password; stored encrypted once saved in Admin
# SMTP_FROM=alerts@yourcompany.ie
# ALERT_TO=you@yourcompany.ie, owner@yourcompany.ie

# ---- Backups (editable later in Admin → Data) ----
# BACKUP_DIR=/mnt/usb/ledger-backups   # a mounted USB / external drive; empty = data/backups
# BACKUP_EVERY_HOURS=24                # automatic application backup; 0 = off
# BACKUP_KEEP=14                       # how many of each kind to keep

# Initial defaults (editable later in Admin):
# COMPANY_NAME=Cormac Roofing Ltd
# BASE_CURRENCY=EUR
# COUNTRY=Ireland
# ANTHROPIC_API_KEY=sk-ant-...
# EXTRACT_MODEL=claude-opus-5-5
# EXTRACT_EFFORT=medium
# AUTO_SYNC_MINUTES=0
